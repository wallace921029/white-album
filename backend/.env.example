# Copy to .env (or set as real environment variables) for local/dev runs.
# In Docker, mount a single volume at DATA_DIR to persist the DB and photos.

# Directory holding the SQLite database and uploaded photos.
DATA_DIR=./data

# Override individual paths if you don't want both under DATA_DIR.
# DATABASE_PATH=./data/app.db
# UPLOAD_DIR=./data/uploads

# Drizzle migrations folder (generated by `npm run db:generate`, applied on boot).
# MIGRATIONS_DIR=./drizzle

# REQUIRED in production: secret used to sign JWTs.
JWT_SECRET=change-me-to-a-long-random-string
# JWT_EXPIRES_IN=30d

# Allowed CORS origin(s). Use the frontend origin in production, e.g. https://album.example.com
CORS_ORIGIN=*

# Max upload size in bytes (default 25MB).
# MAX_UPLOAD_BYTES=26214400

# Bootstrap invite code (first user registration, becomes admin)
BOOTSTRAP_INVITE_CODE=MantleAdmin2026
