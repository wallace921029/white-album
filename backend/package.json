{
  "name": "backend",
  "version": "1.0.0",
  "description": "This project was bootstrapped with Fastify-CLI.",
  "main": "dist/src/app.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "fastify start -l info dist/src/app.js",
    "dev": "npm run build && concurrently -k -n tsc,app -c blue,green \"tsc -w --preserveWatchOutput\" \"fastify start -w -l info dist/src/app.js\"",
    "test": "tsc && node --test \"dist/test/**/*.test.js\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/autoload": "^6.0.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^10.1.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/sensible": "^6.0.0",
    "@fastify/static": "^9.1.3",
    "axios": "^1.18.1",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.9.0",
    "fastify-cli": "^7.4.1",
    "fastify-plugin": "^5.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.0.1",
    "concurrently": "^10.0.3",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.3"
  }
}
